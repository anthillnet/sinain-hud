# Sinain Paranoid Mode — fully offline, zero cloud
# Usage: ./start.sh --paranoid
# Or:    cp .env.paranoid .env && ./start.sh
#
# Prerequisites:
#   ollama serve
#   ollama pull phi4-mini qwen2.5vl:7b
#   brew install whisper-cpp
#   Download a whisper model → ~/.sinain/models/whisper/ggml-large-v3-turbo.bin
#   (or just run ./setup-local-stt.sh, which downloads it there for you)

# ── Local mode (unified) ──────────────────────────────
SINAIN_LOCAL_MODE=true
SINAIN_LOCAL_LLM=phi4-mini
SINAIN_LOCAL_VISION=qwen2.5vl:7b

# ── Privacy ────────────────────────────────────────────
PRIVACY_MODE=paranoid

# ── Audio transcription — local whisper.cpp ────────────
TRANSCRIPTION_BACKEND=local
LOCAL_WHISPER_BIN=whisper-cli
LOCAL_WHISPER_MODEL=~/.sinain/models/whisper/ggml-large-v3-turbo.bin
LOCAL_WHISPER_TIMEOUT_MS=15000

# ── Privacy overrides for escalation ───────────────────
# Allow redacted OCR + audio in escalations (agent_gateway
# is a deliberate user-configured destination, not a leak).
PRIVACY_OCR_AGENT_GATEWAY=redacted
PRIVACY_AUDIO_AGENT_GATEWAY=redacted

# ── No cloud API keys ─────────────────────────────────
OPENROUTER_API_KEY=
