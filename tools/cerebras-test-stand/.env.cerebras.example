# SinainHUD — Cerebras cloud backend preset
#
# Copy the relevant lines into your project-root .env (or `source` exported
# versions) to run sinain-core's analyzer against Cerebras instead of OpenRouter.
#
#   cp tools/cerebras-test-stand/.env.cerebras.example .env.cerebras
#   # edit CEREBRAS_API_KEY, then:
#   set -a && . ./.env.cerebras && set +a && (cd sinain-core && npm run dev)

# ── Required ────────────────────────────────────────────────────────────────
ANALYSIS_PROVIDER=cerebras
CEREBRAS_API_KEY=                 # get one at https://cloud.cerebras.ai

# ── Optional overrides (defaults shown are what ANALYSIS_PROVIDER=cerebras sets) ─
# ANALYSIS_MODEL=gpt-oss-120b     # any id from `GET /v1/models` (check.mjs lists them)
# ANALYSIS_ENDPOINT=https://api.cerebras.ai/v1/chat/completions
# ANALYSIS_FALLBACK_MODELS=       # empty: the google/* + anthropic/* defaults 404 on Cerebras
# SINAIN_AGENT_VISION=false       # Cerebras models are text-only; agent vision auto-off
# ANALYSIS_TIMEOUT=15000

# ── SLM-ROI lane (the fast "auto-detect issues" eyes) ───────────────────────
# Runs in PARALLEL to the analyzer. With no local Ollama it auto-flips to the
# cloud lane, which now follows the analyzer onto Cerebras automatically — no
# extra config. Toggle the eyes at runtime in the overlay (AUTO-DETECT ISSUES).
# REGION_SLM_CLOUD_MODEL=gpt-oss-120b     # defaults to the Cerebras model
# REGION_SLM_CLOUD_ENDPOINT=https://api.cerebras.ai/v1/chat/completions
# REGION_SLM_MAX_TOKENS=512               # 512 on cerebras (256 truncates the verbose model)

# ── Audio transcription (Cerebras can't do audio — text+vision only) ─────────
# Cloud transcription is now provider-agnostic (TRANSCRIPTION_ENDPOINT /
# TRANSCRIPTION_API_KEY / TRANSCRIPTION_MODEL), but Cerebras has no audio model,
# so pick one of:
#   (a) on-device whisper — fully local, no cloud audio key:
TRANSCRIPTION_BACKEND=local
#   (b) keep an audio-capable cloud endpoint just for transcription:
# TRANSCRIPTION_BACKEND=openrouter
# TRANSCRIPTION_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# TRANSCRIPTION_API_KEY=          # or OPENROUTER_API_KEY; separate from the Cerebras key
