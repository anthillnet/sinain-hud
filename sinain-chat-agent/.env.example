# Copy to .env (gitignored) and fill in. Rotate any key that was shared.

# Provider: openrouter (cloud, default) or ollama (local). Auto-detects ollama
# when SINAIN_LOCAL_MODE=true. Local mode needs no OPENROUTER_API_KEY.
SINAIN_CHAT_PROVIDER=openrouter

# --- Cloud (openrouter) ---
OPENROUTER_API_KEY=
SINAIN_CHAT_MODEL=qwen/qwen3.5-flash-02-23
SINAIN_CHAT_REASONING=off          # off = fast chat; on = let the model reason (slower)

# --- Local (ollama) ---
# Set SINAIN_CHAT_PROVIDER=ollama (or SINAIN_LOCAL_MODE=true) and a tool-capable
# local model. Bare tags get the litellm ollama_chat/ prefix automatically.
# Default when unset/cloud-slug: qwen2.5:7b (phi4-mini's tool-calling is weak).
# SINAIN_CHAT_MODEL=qwen2.5:7b
# SINAIN_CHAT_BASE_URL=http://localhost:11434

SINAIN_CORE_URL=http://localhost:9500
SINAIN_CHAT_WS_PORT=9610
